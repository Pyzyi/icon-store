# Copy to .env (never commit .env) – used by `npm start` via `node --env-file=.env` or by docker compose.

# REQUIRED. At least 32 characters. Generate with:  openssl rand -hex 32
ADMIN_KEY=

# Where icons and metadata.json live (default: ./data)
DATA_DIR=./data
HOST=0.0.0.0
PORT=3000

# Limits
MAX_UPLOAD_MB=8
MAX_TOTAL_SIZE_MB=1024
MAX_IMPORT_MB=1024
MAX_CONCURRENT_UPLOADS=4

# Behind a reverse proxy: number of proxy hops (usually 1), "true", or a subnet list
TRUST_PROXY=false
# auto = Secure flag only when the request arrived via HTTPS
COOKIE_SECURE=auto
# Extra allowed origins for write requests, comma separated (e.g. https://icons.example.org)
ALLOWED_ORIGINS=
SESSION_TTL_HOURS=12

# Rate limits (per IP): login attempts per minute, uploads per 10 minutes
LOGIN_RATE_LIMIT=5
UPLOAD_RATE_LIMIT=120

# Read-only browsing of the icon list without login
PUBLIC_BROWSE=false
# Allow "Authorization: Bearer <ADMIN_KEY>" for scripts (no CSRF risk, but key travels with every call)
ALLOW_API_BEARER=false
# Re-encode PNG/JPEG/WebP/GIF to strip metadata and appended data
REENCODE_RASTER=true

# Optional additional audit log file (audit events always go to stdout)
AUDIT_LOG_FILE=
LOG_LEVEL=info

# DANGER: only for isolated test setups. Disables authentication entirely.
ALLOW_INSECURE_NO_AUTH=false
